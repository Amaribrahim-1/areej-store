NEXT_PUBLIC_SUPABASE_URL= your supabase url
NEXT_PUBLIC_SUPABASE_ANON_KEY= your supabase anon key

# Production domain (no trailing slash) — used for metadataBase, canonical
# URLs, robots.txt, and the sitemap. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://areej.example.com

# --- Order admin notifications (server-only; never NEXT_PUBLIC_) ---
# CallMeBot WhatsApp (personal-use API). Activate Alaa's number first:
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Bot contact (confirm on that page; it can change): +34 623 75 84 18
# Send: "I allow callmebot to send me messages" → receive APIKEY
CALLMEBOT_PHONE=+20XXXXXXXXXX
CALLMEBOT_APIKEY=

# Resend email fallback — https://resend.com/docs/send-with-nodejs
# Free tier is enough for low COD volume. Verify a domain for production From.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL_TO=alaa@example.com
ORDER_NOTIFY_EMAIL_FROM=Areej <onboarding@resend.dev>